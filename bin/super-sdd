#!/usr/bin/env bash
# Copies the super-sdd schema and its skills into an OpenSpec project.
# Setting up OpenSpec itself is the user's job; this only installs super-sdd.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION")"
# VERSION is <openspec-version>.<revision>, so dropping the last field leaves the
# exact OpenSpec release this was checked against, and dropping two leaves its series.
OPENSPEC_VERSION="${VERSION%.*}"
OPENSPEC_SERIES="${OPENSPEC_VERSION%.*}"
TARGET="OpenSpec ${OPENSPEC_SERIES}.x, checked against ${OPENSPEC_VERSION}"

SCHEMA_SRC="$ROOT/openspec/schemas/super-sdd"
# The sync skill, plus the two skills the schema and sync skill send durable design
# writing and diagrams to. All three ship together so the schema never names a skill
# the project lacks.
SKILLS=(openspec-sync-designs design-docs technical-diagrams)
CONFIG_SRC="$ROOT/openspec/config.yaml"

warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
super-sdd $VERSION ($TARGET)

Usage:
  super-sdd install [--force]
      Copy the schema and its skills into the current OpenSpec project.
      Run 'openspec init' first; this does not set up OpenSpec.
      --force   Replace files that already exist, and merge the super-sdd
                settings into an edited openspec/config.yaml
  super-sdd version
      Print the version and the OpenSpec release it targets
EOF
}

check_openspec() {
  if ! command -v openspec >/dev/null 2>&1; then
    warn "openspec CLI not found on PATH; super-sdd $VERSION targets $TARGET"
    return
  fi
  local found series
  # Tolerate a failing CLI: a mise shim with no active version exits non-zero here.
  found="$(openspec --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
  if [ -z "$found" ]; then
    warn "could not parse 'openspec --version'; super-sdd $VERSION targets $TARGET"
    return
  fi
  series="${found%.*}"
  if [ "$series" != "$OPENSPEC_SERIES" ]; then
    warn "OpenSpec CLI $found is installed, but super-sdd $VERSION targets $TARGET"
  fi
}

# Clear an existing destination, or stop unless $FORCE. The -L test matters on its own
# because -e is false for a dangling symlink, which ln would then refuse to replace.
clear_dest() {
  if [ -e "$1" ] || [ -L "$1" ]; then
    [ "$FORCE" = yes ] || die "$1 already exists; re-run with --force to replace it"
    rm -rf "$1"
  fi
}

# Copy $1 into directory $2.
copy_into() {
  local src="$1" dest_dir="$2" dest
  dest="$dest_dir/$(basename "$src")"
  clear_dest "$dest"
  mkdir -p "$dest_dir"
  cp -R "$src" "$dest"
  printf 'wrote %s\n' "$dest"
}

# Symlink $1 into directory $2. The target is relative to $2, not to the current
# directory, so the link survives the project moving.
link_into() {
  local target="$1" dest_dir="$2" dest
  dest="$dest_dir/$(basename "$target")"
  clear_dest "$dest"
  mkdir -p "$dest_dir"
  ln -s "$target" "$dest"
  printf 'linked %s -> %s\n' "$dest" "$target"
}

# True when config.yaml carries no settings beyond its schema line, which is what
# 'openspec init' leaves behind: one schema key and a block of example comments.
config_is_untouched() {
  ! grep -vE '^[[:space:]]*(#|$)' openspec/config.yaml | grep -qvE '^schema:'
}

# Print $1 with the super-sdd settings merged in: "schema: super-sdd", and each
# operations.archive.guidance entry from $CONFIG_SRC that the list lacks. Every other line
# is kept as it is, comments included. This edits text rather than parsing YAML, so it
# knows block-style mappings and lists only. On anything else (flow style such as
# "operations: {}", several documents, CRLF line endings) it prints nothing and exits 2.
merge_config() {
  ENTRIES="$(sed -n 's/^[[:space:]]*- //p' "$CONFIG_SRC")" awk '
    function indent(s) { match(s, /^ */); return RLENGTH }
    function content(s) { return s !~ /^ *(#|$)/ }
    function trim(s) { sub(/^ +/, "", s); sub(/ +$/, "", s); return s }
    function pad(k,   s) { s = ""; while (k-- > 0) s = s " "; return s }
    # The unquoted key that line i starts, or "" when it is not a mapping key.
    # A key whose value sits on the same line is flow style or a scalar: give up.
    function key(i,   k, rest) {
      if (!match(L[i], /^ *["\047]?[A-Za-z0-9_.-]+["\047]? *:( |$)/)) return ""
      k = trim(substr(L[i], 1, RLENGTH)); rest = substr(L[i], RLENGTH + 1)
      sub(/ *:$/, "", k); gsub(/["\047]/, "", k)
      if ((k == "operations" || k == "archive" || k == "guidance") && rest !~ /^ *(#.*)?$/) exit 2
      return k
    }
    # The last line of the block that line i opens: its children are indented deeper.
    function block_end(i,   j, e) {
      e = i
      for (j = i + 1; j <= n; j++) {
        if (!content(L[j])) continue
        if (indent(L[j]) <= indent(L[i])) break
        e = j
      }
      return e
    }
    # The first child of line i whose key is k, or 0. Children sit at the indent of
    # the first content line inside the block.
    function child(i, e, k,   j, ci) {
      ci = -1
      for (j = i + 1; j <= e; j++) {
        if (!content(L[j])) continue
        if (ci < 0) ci = indent(L[j])
        if (indent(L[j]) == ci && key(j) == k) return j
      }
      return 0
    }
    function child_indent(i, e,   j) {
      for (j = i + 1; j <= e; j++) if (content(L[j])) return indent(L[j])
      return indent(L[i]) + 2
    }
    function items(ind,   s, m) {
      s = ""
      for (m = 1; m <= nmiss; m++) s = s "\n" pad(ind) "- " MISS[m]
      return substr(s, 2)
    }
    { L[++n] = $0 }
    END {
      nent = split(ENVIRON["ENTRIES"], E, "\n")
      for (i = 1; i <= n; i++) {
        if (L[i] ~ /\r$/ || L[i] ~ /^(---|\.\.\.)( |$)/) exit 2
        if (!content(L[i]) || indent(L[i]) > 0) continue
        k = key(i)
        if (k == "") exit 2
        if (k == "schema" && !schema) schema = i
        if (k == "operations") { if (ops) exit 2; ops = i }
      }

      # Find the guidance list, or the deepest parent that exists, and what to add.
      if (ops) { oe = block_end(ops); arch = child(ops, oe, "archive") }
      if (arch) { ae = block_end(arch); guid = child(arch, ae, "guidance") }
      if (guid) {
        # A block list may sit at the same indent as its key, so "- " lines there
        # still belong to it.
        ge = guid; gi = -1
        for (j = guid + 1; j <= n; j++) {
          if (!content(L[j])) continue
          if (indent(L[j]) < indent(L[guid])) break
          if (indent(L[j]) == indent(L[guid]) && L[j] !~ /^ *- /) break
          if (gi < 0) { if (L[j] !~ /^ *- /) exit 2; gi = indent(L[j]) }
          if (indent(L[j]) == gi) HAVE[trim(substr(L[j], gi + 3))] = 1
          ge = j
        }
        if (gi < 0) gi = indent(L[guid]) + 2
      }
      for (m = 1; m <= nent; m++) if (E[m] != "" && !(E[m] in HAVE)) MISS[++nmiss] = E[m]

      if (nmiss) {
        if (guid) {
          AFTER[ge] = items(gi)
        } else if (arch) {
          ci = child_indent(arch, ae); step = ci - indent(L[arch])
          AFTER[ae] = pad(ci) "guidance:\n" items(ci + step)
        } else if (ops) {
          ci = child_indent(ops, oe)
          AFTER[oe] = pad(ci) "archive:\n" pad(2 * ci) "guidance:\n" items(3 * ci)
        } else {
          AFTER[n] = (n && content(L[n]) ? "\n" : "") "operations:\n  archive:\n    guidance:\n" items(6)
        }
      }

      if (!schema) print "schema: super-sdd"
      for (i = 1; i <= n; i++) {
        print (i == schema ? "schema: super-sdd" : L[i])
        if (i in AFTER) print AFTER[i]
      }
    }
  ' "$1"
}

install_cmd() {
  [ -d openspec ] || die "no openspec/ directory here; run 'openspec init' first"
  check_openspec

  # Check every destination before the first write, so a refusal never leaves a
  # half-installed project behind.
  local skill dest dests=(openspec/schemas/super-sdd)
  for skill in "${SKILLS[@]}"; do
    dests+=(".agents/skills/$skill")
    [ -d .claude ] && dests+=(".claude/skills/$skill")
  done
  if [ "$FORCE" != yes ]; then
    for dest in "${dests[@]}"; do
      if [ -e "$dest" ] || [ -L "$dest" ]; then
        die "$dest already exists; re-run with --force to replace it"
      fi
    done
  fi

  copy_into "$SCHEMA_SRC" openspec/schemas
  for skill in "${SKILLS[@]}"; do
    copy_into "$ROOT/.agents/skills/$skill" .agents/skills
    # Claude reads .claude/skills. Key the mirror on .claude itself, not .claude/skills:
    # a project can use Claude without that subdirectory existing yet. Link rather than
    # copy, so the project holds one copy of the skill and the two cannot drift apart.
    if [ -d .claude ]; then
      link_into "../../.agents/skills/$skill" .claude/skills
    fi
  done

  # A config.yaml with real project settings is never replaced. --force merges the
  # super-sdd settings into it instead, keeping everything else.
  local cfg=openspec/config.yaml merged
  if [ ! -f "$cfg" ] || config_is_untouched; then
    cp "$CONFIG_SRC" "$cfg"
    printf 'wrote %s\n' "$cfg"
  else
    merged="$(mktemp)"
    if ! merge_config "$cfg" > "$merged"; then
      printf 'kept %s; its layout is too unusual to edit safely. Set "schema: super-sdd"\n' "$cfg"
      printf 'and merge the operations.archive.guidance entry from %s by hand\n' "$CONFIG_SRC"
    elif cmp -s "$merged" "$cfg"; then
      printf 'kept %s; it already has the super-sdd settings\n' "$cfg"
    elif [ "$FORCE" = yes ]; then
      # Write through the existing file, so its permissions and any symlink survive.
      cat "$merged" > "$cfg"
      printf 'merged the super-sdd settings into %s\n' "$cfg"
    else
      printf 'kept %s; re-run with --force to set "schema: super-sdd" and add the\n' "$cfg"
      printf 'operations.archive.guidance entry, keeping your other settings\n'
    fi
    rm -f "$merged"
  fi

  printf '\nnext: openspec schema validate super-sdd --verbose\n'
}

FORCE=no
cmd="${1:-}"
shift || true
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=yes ;;
    *) die "unknown option: $arg" ;;
  esac
done

case "$cmd" in
  install) install_cmd ;;
  version) printf '%s (%s)\n' "$VERSION" "$TARGET" ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
