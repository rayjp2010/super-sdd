#!/usr/bin/env bash
# Copies the super-sdd schema and sync skill into an OpenSpec project.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION")"
# VERSION is <openspec-version>.<revision>, so dropping the last field leaves the
# exact OpenSpec release this was checked against, and dropping two leaves its series.
OPENSPEC_VERSION="${VERSION%.*}"
OPENSPEC_SERIES="${OPENSPEC_VERSION%.*}"
TARGET="OpenSpec ${OPENSPEC_SERIES}.x, checked against ${OPENSPEC_VERSION}"

SCHEMA_SRC="$ROOT/openspec/schemas/super-sdd"
SKILL_SRC="$ROOT/.agents/skills/openspec-sync-designs"
CONFIG_SRC="$ROOT/openspec/config.yaml"

warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
super-sdd $VERSION ($TARGET)

Usage:
  super-sdd install [--force] [--no-openspec] [--no-init] [--tools <list>]
      Set up super-sdd in the current project: pin and install
      npm:@fission-ai/openspec@${OPENSPEC_VERSION}, run openspec init when
      openspec/ is missing, then copy in the schema and sync skill.
      --force          Replace files that already exist
      --no-openspec    Leave mise.toml alone
      --no-init        Never run openspec init; fail if openspec/ is missing
      --tools <list>   Which agent tools this project uses (default: claude).
                       Passed to openspec init, and naming claude also mirrors
                       the sync skill into .claude/skills.
  super-sdd version
      Print the version and the OpenSpec release it targets
EOF
}

check_openspec() {
  if ! command -v openspec >/dev/null 2>&1; then
    warn "openspec CLI not found on PATH; super-sdd $VERSION targets $TARGET"
    return
  fi
  local found series
  # Tolerate a failing CLI: a mise shim with no active version exits non-zero here.
  found="$(openspec --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
  if [ -z "$found" ]; then
    warn "could not parse 'openspec --version'; super-sdd $VERSION targets $TARGET"
    return
  fi
  series="${found%.*}"
  if [ "$series" != "$OPENSPEC_SERIES" ]; then
    warn "OpenSpec CLI $found is installed, but super-sdd $VERSION targets $TARGET"
  fi
}

# Pin the OpenSpec CLI this release was checked against in the project's mise.toml,
# creating the file or replacing an existing pin. 'mise use' owns the TOML edit because
# 'mise config set' mangles a key holding ':' and '@', and hand-editing guesses at layout.
pin_openspec() {
  local pin="npm:@fission-ai/openspec@$OPENSPEC_VERSION"
  if ! command -v mise >/dev/null 2>&1; then
    warn "mise not found; pin the CLI yourself with: mise use \"$pin\""
    return
  fi
  if mise use "$pin" >/dev/null 2>&1; then
    printf 'pinned %s in mise.toml\n' "$pin"
  else
    # Most often an untrusted mise.toml: mise refuses to edit a config carrying env or tasks.
    warn "could not update mise.toml; run 'mise trust' if it is untrusted, then: mise use \"$pin\""
  fi
}

# Run the OpenSpec CLI at the version this release targets. Going through mise exec
# rather than PATH means the right version runs even when the caller's shell resolves
# openspec to a shim with no active version, which is the state that broke the old
# init-then-install order.
run_openspec() {
  if command -v mise >/dev/null 2>&1; then
    mise exec "npm:@fission-ai/openspec@$OPENSPEC_VERSION" -- openspec "$@"
  elif command -v openspec >/dev/null 2>&1; then
    openspec "$@"
  else
    die "no OpenSpec CLI available; install mise, or run 'openspec init' yourself"
  fi
}

# Clear an existing destination, or stop unless $FORCE. The -L test matters on its own
# because -e is false for a dangling symlink, which ln would then refuse to replace.
clear_dest() {
  if [ -e "$1" ] || [ -L "$1" ]; then
    [ "$FORCE" = yes ] || die "$1 already exists; re-run with --force to replace it"
    rm -rf "$1"
  fi
}

# Copy $1 into directory $2.
copy_into() {
  local src="$1" dest_dir="$2" dest
  dest="$dest_dir/$(basename "$src")"
  clear_dest "$dest"
  mkdir -p "$dest_dir"
  cp -R "$src" "$dest"
  printf 'wrote %s\n' "$dest"
}

# Symlink $1 into directory $2. The target is relative to $2, not to the current
# directory, so the link survives the project moving.
link_into() {
  local target="$1" dest_dir="$2" dest
  dest="$dest_dir/$(basename "$target")"
  clear_dest "$dest"
  ln -s "$target" "$dest"
  printf 'linked %s -> %s\n' "$dest" "$target"
}

# True when $TOOLS names Claude. Comma-delimited matching avoids grep word boundaries,
# which are not portable, and handles lists like "codex,claude".
tools_include_claude() {
  case ",$TOOLS," in
    *,claude,*|*,all,*) return 0 ;;
    *) return 1 ;;
  esac
}

# True when config.yaml carries no settings beyond its schema line, which is what
# 'openspec init' leaves behind: one schema key and a block of example comments.
config_is_untouched() {
  ! grep -vE '^[[:space:]]*(#|$)' openspec/config.yaml | grep -qvE '^schema:'
}

install_cmd() {
  # Pin first: it installs the CLI that openspec init needs, and it lets the version
  # check below see a CLI this run just made available.
  if [ "$PIN_OPENSPEC" = yes ]; then
    pin_openspec
  fi
  check_openspec

  # init also creates the tool's skills directory, which decides whether the
  # .claude/skills mirror below happens at all.
  if [ ! -d openspec ]; then
    [ "$RUN_INIT" = yes ] || die "no openspec/ directory here; run 'openspec init' or drop --no-init"
    printf 'running openspec init --tools %s\n' "$TOOLS"
    run_openspec init --tools "$TOOLS" --no-animation >/dev/null
    [ -d openspec ] || die "openspec init did not create openspec/"
    printf 'wrote openspec/\n'
  fi

  copy_into "$SCHEMA_SRC" openspec/schemas
  copy_into "$SKILL_SRC" .agents/skills
  # Claude reads .claude/skills. Mirror when --tools names Claude, creating the directory
  # if needed: a project that already had openspec/ skips init, so nothing else would ever
  # create it. Also mirror when the directory exists regardless of --tools, so an existing
  # Claude project keeps working. Link rather than copy, so the project holds one copy of
  # the skill and the two locations cannot drift apart.
  if tools_include_claude || [ -d .claude/skills ]; then
    mkdir -p .claude/skills
    link_into "../../.agents/skills/$(basename "$SKILL_SRC")" .claude/skills
  fi

  if [ ! -f openspec/config.yaml ] || config_is_untouched; then
    cp "$CONFIG_SRC" openspec/config.yaml
    printf 'wrote openspec/config.yaml\n'
  else
    printf 'kept openspec/config.yaml; set "schema: super-sdd" and merge the context and\n'
    printf 'operations blocks from %s\n' "$CONFIG_SRC"
  fi

  printf '\nnext: openspec schema validate super-sdd --verbose\n'
}

FORCE=no
PIN_OPENSPEC=yes
RUN_INIT=yes
TOOLS=claude
cmd="${1:-}"
shift || true
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=yes ;;
    --no-openspec) PIN_OPENSPEC=no ;;
    --no-init) RUN_INIT=no ;;
    --tools) shift; [ $# -gt 0 ] || die "--tools needs a value"; TOOLS="$1" ;;
    --tools=*) TOOLS="${1#--tools=}" ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done

case "$cmd" in
  install) install_cmd ;;
  version) printf '%s (%s)\n' "$VERSION" "$TARGET" ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
